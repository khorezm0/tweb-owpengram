
# Domains this deployment is served from (comma-separated). Default: the official
# ones below. Only gates the t.me auth sync (telegramMeWebManager): a self-hosted
# domain keeps its own VITE_API_ID/VITE_API_HASH (config/app.ts).
VITE_MAIN_DOMAINS=web.telegram.org,webk.telegram.org

# MTProto endpoints of a self-hosted server: full URLs, one for every DC and
# connection type (the transport header carries the DC). Leave unset for the
# official per-DC endpoints (wss://kws<dcId>.web.telegram.org/apiws,
# https://<subdomain>.web.telegram.org/apiw1).
#VITE_MTPROTO_WS_URL=wss://your-server.example.com/apiws
#VITE_MTPROTO_HTTP_URL=https://your-server.example.com/apiw1

# Link hosts the in-app handler opens as t.me-style internal links (comma-separated).
VITE_TME_HOSTS=t.me,telegram.me

# RSA public keys of the self-hosted MTProto server (comma-separated `modulus[:exponent]` hex,
# exponent defaults to 010001). The server names the key fingerprint in its first answer (resPQ)
# and the client picks the key by it - a key the client does not know fails the auth with
# "[MT] No public key found". Take the modulus from the server's public key (its config / a .pem),
# printed as hex by:
#   openssl rsa -pubin -in public.pem -text -noout          # an SPKI "PUBLIC KEY" pem
#   openssl rsa -RSAPublicKey_in -in pub.pem -text -noout   # a PKCS#1 "RSAPublicKey" pem
VITE_MTPROTO_RSA_KEYS=

# The MTProto layer the client announces in invokeWithLayer. Default: the schema's own (233).
# Set it to a layer your server admits when it refuses the schema's own: owpengram-server
# speaks canonical layer 232 (accepts 225-232) and answers every call of an unaccepted layer
# with INPUT_REQUEST_INVALID. Safe while the schema is a pure superset of that layer (nothing
# changed, only added) - then the bytes are identical either way.
VITE_API_LAYER=232
